.DS_Store

# Python and notebooks
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Generated outputs
out/
!out/README.md
docs/manuscript/figs/*
!docs/manuscript/figs/.gitkeep
docs/manuscript/tables/*
!docs/manuscript/tables/.gitkeep

# Local data
data/*
!data/README.md
!data/raw/.gitkeep
!data/derived/
!data/derived/.gitkeep
!data/metadata/
!data/metadata/.gitkeep

# Context packages
context_packages/*
!context_packages/
!context_packages/markdowns/
!context_packages/markdowns/**

# Notebook caches
notebooks/cache/
notebooks/results_*
notebooks/eval/results/*anchor.ipynb
notebooks/eval/results/*gp.ipynb
notebooks/eval/results/*rbf.ipynb
notebooks/eval/results/*rbf_shrink.ipynb
notebooks/eval/results/*tprior_gp.ipynb
notebooks/eval/results/*tprior_imq.ipynb
notebooks/eval/results/*tprior_tps.ipynb

# LaTeX build artifacts
*.log
*.synctex.gz